{
  "name": "opensheaf",
  "version": "0.1.0",
  "description": "The tools of OpenSheaf archives (the osheaf command) in JavaScript: Deno, Node and browsers",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "osheaf": "cli/osheaf.js"
  },
  "exports": {
