  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "tweetnacl": "1.0.3",
    "yaml": "2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensheaf/opensheaf-js.git"
  },
  "homepage": "https://opensheaf.org/opensheaf-js/"
