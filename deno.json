  "imports": {
    "hash-wasm": "npm:hash-wasm@4.12.0",
    "pako": "npm:pako@2.1.0",
    "tweetnacl": "npm:tweetnacl@1.0.3",
    "yaml": "npm:yaml@2.8.1"
  },
  "nodeModulesDir": "none",
  "tasks": {
    "osheaf": "deno run -A cli/osheaf.js",
    "test": "deno test -A tests/",
    "tangle": "literate tangle",
    "check": "literate tangle --check",
    "compile": "deno compile -A --include schemas --include templates --output dist/osheaf cli/osheaf.js",
    "bundle": "deno run -A tools/bundle.js"
  }
}
